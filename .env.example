# ============================================================================
# CodeAssess AI - Environment Configuration Example
# Copy this file to `server/.env` (and optionally `client/.env` for custom URLs)
# Never commit real API keys or secrets to version control.
# ============================================================================

# Server Configuration
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
CLIENT_ORIGIN=http://localhost:5173

# Database Configuration
# Primary mode: `mongodb` connects to MongoDB via Mongoose using MONGODB_URI.
# Optional fallback for local environments without a MongoDB daemon: `local_json`
# validates all documents with the Mongoose schemas and stores them locally.
DB_MODE=mongodb
MONGODB_URI=mongodb://127.0.0.1:27017/codeassess_ai

# Authentication Security
# Replace JWT_SECRET with a cryptographically random string (min 32 characters)
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters_long
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false

# AI Provider Configuration
# Supported providers: openai | gemini | anthropic | openai_compatible
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# Optional custom base URL (required when AI_PROVIDER=openai_compatible, e.g. Groq, OpenRouter, Ollama)
AI_BASE_URL=
AI_REQUEST_TIMEOUT_MS=45000

# Sandboxed Code Execution Configuration (Optional)
# Never runs untrusted code on the Express server.
# Supported providers when configured: piston | judge0
# Example Piston API endpoint: https://emkc.org/api/v2/piston/execute (or self-hosted sandbox)
CODE_EXECUTION_PROVIDER=piston
CODE_EXECUTION_URL=
CODE_EXECUTION_API_KEY=
CODE_EXECUTION_TIMEOUT_MS=10000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=150
AI_RATE_LIMIT_MAX_REQUESTS=20

# Optional Frontend Build Overrides (place in client/.env only if needed)
# VITE_API_BASE_URL=/api
# VITE_API_PROXY_TARGET=http://127.0.0.1:5000
